0     < S 0:0(0) win 32767 <mss 1460,sackOK,eol,eol>
+0    > S. 0:0(0) ack 1 win 65535 <mss 1460,sackOK,eol,eol>
+0.10 < . 1:1(0) ack 1 win 32767
+0.10 < F. 1:1(0) ack 1 win 32767
+0    > . 1:1(0) ack 2 win 65535
+0    > F. 1:1(0) ack 2 win 65535
+0.10 < R 2:2(0) win 32767
+0.10 < S 5000:5000(0) win 32767 <mss 1460,sackOK,eol,eol>
+0    > S. 0:0(0) ack 5001 win 65535 <mss 1460,sackOK,eol,eol>
