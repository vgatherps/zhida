0     < S 0:0(0) win 32767 <mss 1460,sackOK,eol,eol>
+0    > S. 0:0(0) ack 1 win 65535 <mss 1460,sackOK,eol,eol>
+0.10 < . 1:1(0) ack 1 win 32767
+0    > F. 1:1(0) ack 1 win 65535
+0.10 < F. 1:1(0) ack 2 win 32767
+0    > . 2:2(0) ack 2 win 65535
+0.10 < F. 1:1(0) ack 2 win 32767
+0.00 > . 2:2(0) ack 2 win 65535
// Double check that the connection is still in TIME-WAIT
+1.10 < F. 1:1(0) ack 2 win 32767
+0    > . 2:2(0) ack 2 win 65535
